{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "AzureStorage": "UseDevelopmentStorage=true"
  },

  //set parameters for JWT
  "Jwt": {
    "Key": "DEVELOPMENT-ONLY-CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-KEY",
    "Issuer": "ApiGateway",
    "Audience": "ApiClient",
    "ExpiryMinutes": 60
  },

  "ReverseProxy": {
    "Routes": {
      "notes-openapi": {
        "ClusterId": "notes-cluster",
        "Match": {
          "Path": "/docs/notes/openapi.json"
        },
        "Transforms": [
          {
            "PathSet": "/api/openapi/v3.json"
          }
        ],
        "AuthorizationPolicy": "Anonymous"
      },
      "notes-read": {
        "ClusterId": "notes-cluster",
        "Match": {
          "Path": "/api/notes/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "AuthorizationPolicy": "Anonymous"
      },
      "notes-write": {
        "ClusterId": "notes-cluster",
        "Match": {
          "Path": "/api/notes/{**catch-all}",
          "Methods": [
            "POST",
            "PUT",
            "DELETE"
          ]
        },
        "AuthorizationPolicy": "authenticated"
      }
    },
    "Clusters": {
      "notes-cluster": {
        "Destinations": {
          "notes-service": {
            "Address": "http://localhost:7063/"
          }
        }
      }
    }
  }
}
